	</Configuration>
	<Configuration Name="Debug|GCC-x64" Toolchain="GCC" Solution="Debug|Win32">
	</Configuration>
	<Configuration Name="Debug|HCP65C816" Toolchain="W65C816" Solution="Debug|Win32">
	</Configuration>
	<Configuration Name="Debug|HCP65C64" Toolchain="65C64" Solution="Debug|Win32">
	</Configuration>
</BuildConfigurations>
