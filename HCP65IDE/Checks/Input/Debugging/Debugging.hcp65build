<?xml version="1.0" encoding="utf-8"?>
<!-- Debugging.cpp, run by the kernal as the start up program of a copy of TestHCP65Lib's boot card (IDEChecks.py makes
     Output\Debugging.img): its STARTUP.TXT runs \boottest.exe, which debugging puts there.  The boot loader and OS.SYS
     are the ones TestHCP65Lib built. -->
<BuildConfigurations>
	<Configuration Name="Debug|W65C816" Toolchain="W65C816" Solution="Debug|Win32" Debug="true" BreakpointSpace="User" MathTables="false" Card="Output\Debugging.img" CardPath="\boottest.exe">
		<Executable File="debugging.exe" Entry="UserStart" Limit="0x200000">
			<Symbol Name="UserHeapSize" Value="0x20000"/>
		</Executable>
		<Load File="..\..\..\..\..\HCP65\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\Boot.rom" Address="0x0"/>
		<Lines File="..\..\..\..\..\HCP65\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\OS.SYS" CardPath="\OS\OS.SYS"/>
	</Configuration>
	<Configuration Name="Release|W65C816" Toolchain="W65C816" Solution="Release|Win32" BreakpointSpace="User" MathTables="false" Card="Output\Debugging.img" CardPath="\boottest.exe">
		<Executable File="debugging.exe" Entry="UserStart" Limit="0x200000">
			<Symbol Name="UserHeapSize" Value="0x20000"/>
		</Executable>
		<Load File="..\..\..\..\..\HCP65\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\Boot.rom" Address="0x0"/>
		<Lines File="..\..\..\..\..\HCP65\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\OS.SYS" CardPath="\OS\OS.SYS"/>
	</Configuration>
</BuildConfigurations>
